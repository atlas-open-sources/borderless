{
  "name": "borderless-g2-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && even-companion-check-whitelist app.json src/profile.ts",
    "build": "npm run check && vite build",
    "dev": "vite --host 127.0.0.1 --port 5191",
    "test": "node --test tests/*.test.mjs",
    "pack": "npm run test && npm run build && evenhub pack app.json dist -o borderless-guest.ehpk --sdk-ver 0.0.14"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.14",
    "even-companion-plugin": "file:../../even-companion/plugin"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
